                        <TextBlock Text="EduGate School Portal • Protected by SoftBuilt Shield" FontSize="14" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="🏫 School Admin (PIN)" Style="{StaticResource SecondaryButton}" Click="BtnOpenSchoolAdminModal_Click" Margin="0,0,10,0" Padding="12,6" FontSize="12"/>
                        <Button Content="🛠️ Developer Unlock" Style="{StaticResource SecondaryButton}" Click="BtnOpenDevUnlockModal_Click" Padding="12,6" FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Kiosk Center Content -->
            <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel MaxWidth="620" HorizontalAlignment="Center">
                    <!-- Branded Logo Container -->
                    <Border Width="110" Height="110" CornerRadius="24" Background="#1E293B" BorderBrush="#334155" BorderThickness="2" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <Grid>
                            <Image x:Name="ImgKioskLogo" Width="90" Height="90" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtKioskFallbackLogo" Text="🎓" FontSize="52" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Titles -->
                    <TextBlock x:Name="TxtKioskTitle" Text="EduGate School Management System" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Smart Attendance, Student Records, Billing &amp; Instant SMS Gateway" FontSize="14" Foreground="#94A3B8" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,28"/>

                    <!-- Realtime System Status Pill -->
                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="20" Padding="18,10" HorizontalAlignment="Center" Margin="0,0,0,28">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="DotKioskStatus" Width="10" Height="10" Fill="#10B981" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtKioskStatus" Text="System Online: Apache &amp; MySQL Ready" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Big Launch Button -->
                    <Button Content="🚀   Launch EduGate System" Style="{StaticResource SuccessButton}" Click="BtnKioskLaunch_Click" FontSize="18" FontWeight="Bold" Padding="40,18" HorizontalAlignment="Center" Cursor="Hand" Margin="0,0,0,12"/>
                    <TextBlock Text="Clicking automatically ensures background services are active and opens EduGate in your browser." FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" TextAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Kiosk Footer -->
            <Border Grid.Row="2" Background="#0F172A" BorderBrush="#1E2937" BorderThickness="0,1,0,0" Padding="24,0">
                <Grid VerticalAlignment="Center">
                    <TextBlock Text="Host Server: Active • Local Port: 80 • Isolated Runtime Mode" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>
                    <Button Content="🔄 Check / Restart Services" Style="{StaticResource SecondaryButton}" Click="BtnKioskRestartServices_Click" HorizontalAlignment="Right" Padding="10,5" FontSize="11"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= SCHOOL ADMIN MODAL DIALOG ================= -->
        <Grid x:Name="ModalSchoolAdmin" Grid.Column="0" Grid.ColumnSpan="2" Background="#DD000000" Visibility="Collapsed">
            <Border Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="12" Width="540" MaxHeight="720" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- School Admin PIN Entry Panel -->
                        <StackPanel x:Name="PanelSchoolPinEntry">
                            <TextBlock Text="🏫 School Administrator Verification" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                            <TextBlock Text="Enter the School PIN to access authorized administrative safeguards and database configuration." FontSize="12" Foreground="#9CA3AF" Margin="0,0,0,20"/>

                            <TextBlock Text="School Admin PIN:" FontSize="12" Foreground="#D1D5DB" Margin="0,0,0,6"/>
                            <PasswordBox x:Name="TxtSchoolPinInput" FontSize="16" Background="#111827" Foreground="#FFFFFF" BorderBrush="#4B5563" Padding="8,6" Margin="0,0,0,16"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Click="BtnCloseSchoolAdmin_Click" Margin="0,0,8,0" Padding="14,8"/>
                                <Button Content="Verify PIN" Click="BtnVerifySchoolPin_Click" Padding="18,8"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- School Admin Actions Panel (Shown once PIN verified) -->
                        <StackPanel x:Name="PanelSchoolActions" Visibility="Collapsed">
                            <TextBlock Text="🏫 School Administration &amp; Data Safeguards" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                            <TextBlock Text="Authorized administrative safeguards. Direct unauthorized raw modifications are blocked." FontSize="12" Foreground="#9CA3AF" Margin="0,0,0,16"/>

                            <!-- 1-Click Backup -->
                            <Border Background="#111827" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="📥 1-Click Safe Database Backup" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                    <TextBlock Text="Exports a full, timestamped copy of all students, attendance records, and billing to a secure backup file." FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                    <Button Content="Export Instant Database Backup (.sql)" Style="{StaticResource SuccessButton}" Click="BtnSchoolBackupDb_Click" HorizontalAlignment="Left" Padding="14,8"/>
                                </StackPanel>
                            </Border>

                            <!-- XAMPP Database Credentials Safeguard -->
                            <Border Background="#111827" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="🛡️ XAMPP Database Credentials &amp; phpMyAdmin Safeguard" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                    <TextBlock Text="Set or change the XAMPP MySQL database username and password. Used to securely access phpMyAdmin." FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Admin Username (phpMyAdmin):" FontSize="11" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtSchoolAdminDbUser" Grid.Column="1" Text="root" FontSize="13" Background="#1E293B" Foreground="#FFFFFF" BorderBrush="#4B5563" Padding="8,4"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Current DB Password (blank if default):" FontSize="10" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                        <PasswordBox x:Name="TxtSchoolAdminDbCurrentPass" Grid.Column="1" FontSize="13" Background="#1E293B" Foreground="#FFFFFF" BorderBrush="#4B5563" Padding="8,4"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="New DB Password:" FontSize="11" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                        <PasswordBox x:Name="TxtSchoolAdminDbNewPass" Grid.Column="1" FontSize="13" Background="#1E293B" Foreground="#FFFFFF" BorderBrush="#4B5563" Padding="8,4"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Confirm New Password:" FontSize="11" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                        <PasswordBox x:Name="TxtSchoolAdminDbConfirmPass" Grid.Column="1" FontSize="13" Background="#1E293B" Foreground="#FFFFFF" BorderBrush="#4B5563" Padding="8,4"/>
                                    </Grid>

                                    <CheckBox x:Name="ChkSchoolSyncPhpMyAdmin" Content="Synchronize with phpMyAdmin (config.inc.php)" IsChecked="True" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,6"/>
                                    <CheckBox x:Name="ChkSchoolPmaRequireLogin" Content="🔒 Require Password Login on phpMyAdmin (Blocks unauthorized access from network)" IsChecked="True" FontSize="11" Foreground="#34D399" Margin="0,0,0,6"/>
                                    <CheckBox x:Name="ChkSchoolBlockPmaLan" Content="🛡️ Block phpMyAdmin on LAN (Allow Localhost Only)" IsChecked="True" FontSize="11" Foreground="#38BDF8" Margin="0,0,0,12"/>

                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="💾 Apply DB Credentials" Style="{StaticResource SuccessButton}" Click="BtnSchoolUpdateDbPassword_Click" Padding="14,6" Margin="0,0,8,0"/>
                                        <Button Content="🔍 Test Connection" Style="{StaticResource SecondaryButton}" Click="BtnSchoolTestDbConnection_Click" Padding="12,6"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Change PIN -->
                            <Border Background="#111827" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="🔑 Change School Admin PIN" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="TxtNewSchoolPin" Grid.Column="0" FontSize="14" Background="#1E293B" Foreground="#FFFFFF" BorderBrush="#4B5563" Padding="8,4" Margin="0,0,8,0"/>
                                        <Button Grid.Column="1" Content="Update PIN" Style="{StaticResource SecondaryButton}" Click="BtnSchoolUpdatePin_Click" Padding="12,6"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="TxtSchoolAdminStatus" Text="" FontSize="11" Foreground="#10B981" Margin="0,0,0,16" TextWrapping="Wrap"/>

                            <Button Content="Done / Close" Style="{StaticResource SecondaryButton}" Click="BtnCloseSchoolAdmin_Click" HorizontalAlignment="Right" Padding="16,8"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ================= DEVELOPER UNLOCK MODAL DIALOG ================= -->
        <Grid x:Name="ModalDevUnlock" Grid.Column="0" Grid.ColumnSpan="2" Background="#DD000000" Visibility="Collapsed">
            <Border Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="12" Width="440" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28">
                <StackPanel>
                    <TextBlock Text="🛠️ Developer / Master Admin Authentication" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                    <TextBlock Text="Enter your master developer passcode to unlock full vault, build, obfuscation, and deployment controls." FontSize="12" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,0,0,20"/>

                    <TextBlock Text="Master Passcode:" FontSize="12" Foreground="#D1D5DB" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="TxtDevMasterPasscodeInput" FontSize="16" Background="#111827" Foreground="#FFFFFF" BorderBrush="#4B5563" Padding="8,6" Margin="0,0,0,16"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Click="BtnCancelDevUnlock_Click" Margin="0,0,8,0" Padding="14,8"/>
                        <Button Content="Unlock Full Dashboard" Style="{StaticResource WarningButton}" Click="BtnVerifyDevPasscode_Click" Padding="18,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= DATABASE SECURITY AUTHENTICATION MODAL ================= -->
        <Grid x:Name="ModalDbAuth" Grid.Column="0" Grid.ColumnSpan="2" Background="#EE000000" Visibility="Collapsed">
            <Border Background="#1F2937" BorderBrush="#EF4444" BorderThickness="1.5" CornerRadius="12" Width="460" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="🛡️" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Database Security Guard" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="XAMPP database credentials are protected. Enter either your School Administrator PIN or Developer Master Passcode to access or configure the database password." FontSize="12" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,0,0,18"/>

                    <Border Background="#7F1D1D" CornerRadius="6" Padding="10,8" Margin="0,0,0,16">
                        <TextBlock Text="⚠️ Warning: Unauthorized access attempts are monitored and recorded to the security audit trail." FontSize="11" Foreground="#FCA5A5" TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="Admin PIN or Developer Passcode:" FontSize="12" Foreground="#D1D5DB" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="TxtDbAuthPasscodeInput" FontSize="16" Background="#111827" Foreground="#FFFFFF" BorderBrush="#4B5563" Padding="8,6" Margin="0,0,0,18"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Click="BtnCancelDbAuth_Click" Margin="0,0,8,0" Padding="14,8"/>
                        <Button Content="Verify &amp; Unlock DB Settings" Style="{StaticResource WarningButton}" Click="BtnVerifyDbAuth_Click" Padding="18,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= DEVELOPER REMOTE LOCK OVERLAY ================= -->
        <Grid x:Name="ModalRemoteLock" Grid.Column="0" Grid.ColumnSpan="2" Background="#F5000000" Visibility="Collapsed">
            <Border Background="#111827" BorderBrush="#DC2626" BorderThickness="2" CornerRadius="16" Width="560" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32">
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="80" Height="80" CornerRadius="40" Background="#7F1D1D" BorderBrush="#EF4444" BorderThickness="2" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <TextBlock Text="🔒" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="SYSTEM REMOTELY SUSPENDED" FontSize="20" FontWeight="Bold" Foreground="#EF4444" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TxtRemoteLockSchoolHeader" Text="EduGate School Management System" FontSize="14" FontWeight="SemiBold" Foreground="#E2E8F0" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                    <Border Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Reason for Suspension:" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                            <TextBlock x:Name="TxtRemoteLockReasonMessage" Text="System access has been suspended by the developer. Please contact support or clear pending licensing requirements to restore system access." FontSize="13" Foreground="#FCA5A5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Cloud Server: https://edugate-manager-3.onrender.com" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="🔄 Check Status / Refresh Lock" Style="{StaticResource SuccessButton}" Click="BtnRefreshRemoteLock_Click" Padding="18,10" Margin="0,0,12,0" FontSize="13" FontWeight="Bold"/>
                        <Button Content="🛠️ Developer Override" Style="{StaticResource SecondaryButton}" Click="BtnRemoteLockDevOverride_Click" Padding="14,10" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
