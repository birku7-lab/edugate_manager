<Window x:Class="SoftBuilt.PHPShield.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SoftBuilt PHP Shield - EduGate Deployment &amp; Protection Suite"
        Height="820" Width="1240"
        MinHeight="720" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Window.Resources>
        <!-- Nav Button Style -->
        <Style x:Key="NavButtonStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="Transparent" CornerRadius="8" Padding="14,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ContentPresenter/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1F2937"/>
                                <Setter Property="Foreground" Value="#F3F4F6"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#F9FAFB"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR ================= -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="16,20,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- App Brand Header -->
                <StackPanel Grid.Row="0" Margin="4,0,4,24">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="38" Height="38" Background="#1D4ED8" CornerRadius="8" Margin="0,0,12,0">
                            <TextBlock Text="🛡️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SoftBuilt Shield" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="PHP Protection &amp; Deploy" FontSize="11" Foreground="#9CA3AF"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Active Project Pill -->
                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,16,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Target: " FontSize="11" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtSidebarTargetProject" Text="EduGate (Pending Import)" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Navigation Menu -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <RadioButton x:Name="NavDashboard" Style="{StaticResource NavButtonStyle}" Content="📊   Dashboard" IsChecked="True" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavProjects" Style="{StaticResource NavButtonStyle}" Content="📦   Projects &amp; Import" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavAnalysis" Style="{StaticResource NavButtonStyle}" Content="🔍   Project Analysis" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavVault" Style="{StaticResource NavButtonStyle}" Content="🔐   Encrypted Vault" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavBuilds" Style="{StaticResource NavButtonStyle}" Content="⚙️   Production Builds" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavDeploy" Style="{StaticResource NavButtonStyle}" Content="🚀   Guided Deploy" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavXampp" Style="{StaticResource NavButtonStyle}" Content="🐘   XAMPP Environment" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavServices" Style="{StaticResource NavButtonStyle}" Content="⚡   Services &amp; Runtime" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavSecurity" Style="{StaticResource NavButtonStyle}" Content="🛡️   Security Audit" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavButtonStyle}" Content="🔧   Settings &amp; Audit Logs" Checked="Nav_Checked"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- PRD Section 8.2 Honest Limitation Notice -->
                <Border Grid.Row="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="ℹ️  Architecture Note" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <TextBlock Text="Original source stays in encrypted vault. Production code is obfuscated &amp; isolated in XAMPP." FontSize="10" Foreground="#64748B" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ================= MAIN CONTENT ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header & Status Bar -->
            <Border Grid.Row="0" Background="#111827" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="24,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TxtPageTitle" Grid.Column="0" Text="System Overview &amp; Dashboard" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>

                    <!-- Realtime Status Pills -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,16,0" VerticalAlignment="Center">
                        <!-- XAMPP Status -->
                        <Border x:Name="PillXampp" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="DotXampp" Width="8" Height="8" Fill="#10B981" Margin="0,0,6,0"/>
                                <TextBlock x:Name="TxtPillXampp" Text="XAMPP: Ready" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                            </StackPanel>
                        </Border>

                        <!-- Apache Status -->
                        <Border x:Name="PillApache" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="DotApache" Width="8" Height="8" Fill="#9CA3AF" Margin="0,0,6,0"/>
                                <TextBlock x:Name="TxtPillApache" Text="Apache: Checking" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                            </StackPanel>
                        </Border>

                        <!-- MySQL Status -->
                        <Border x:Name="PillMysql" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="DotMysql" Width="8" Height="8" Fill="#9CA3AF" Margin="0,0,6,0"/>
                                <TextBlock x:Name="TxtPillMysql" Text="MySQL: Checking" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                            </StackPanel>
                        </Border>

                        <!-- Vault Status -->
                        <Border x:Name="PillVault" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="10,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtVaultIcon" Text="🔒" FontSize="10" Margin="0,0,6,0"/>
                                <TextBlock x:Name="TxtPillVault" Text="Vault: Locked" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Top Action Shortcuts -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="🔒 Lock Client Mode" Style="{StaticResource WarningButton}" Click="BtnSwitchToKiosk_Click" Margin="0,0,8,0" Padding="10,6" FontSize="12"/>
                        <Button Content="Load EduGate Demo" Style="{StaticResource SuccessButton}" Click="BtnLoadDemo_Click" Margin="0,0,8,0" Padding="10,6" FontSize="12"/>
                        <Button Content="Open Site 🌐" Style="{StaticResource SecondaryButton}" Click="BtnOpenEduGate_Click" Margin="0,0,8,0" Padding="10,6" FontSize="12"/>
                        <Button Content="phpMyAdmin" Style="{StaticResource SecondaryButton}" Click="BtnOpenPhpMyAdmin_Click" Padding="10,6" FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Active View Body Container -->
            <Grid Grid.Row="1" Margin="24,20,24,20">
                <!-- TAB 1: DASHBOARD -->
                <ScrollViewer x:Name="ViewDashboard" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                    <StackPanel>
                        <!-- ═══ Admin Warning Banner (hidden unless not-admin) ═══ -->
                        <Border x:Name="AdminWarningBanner" Visibility="Collapsed"
                                Background="#7F1D1D" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                            <TextBlock x:Name="TxtAdminWarning" TextWrapping="Wrap"
                                       Foreground="#FCA5A5" FontSize="13" FontWeight="SemiBold"/>
                        </Border>

                        <!-- Top 4 Metrics Cards -->
                        <Grid Margin="0,0,0,20">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Card 1: XAMPP Detection -->
                            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="XAMPP INSTALLATION" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF"/>
                                    <TextBlock x:Name="TxtDashXamppStatus" Text="Detecting..." FontSize="18" FontWeight="Bold" Foreground="#10B981" Margin="0,6,0,2"/>
                                    <TextBlock x:Name="TxtDashXamppPath" Text="Checking paths..." FontSize="11" Foreground="#6B7280" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Apache Web Server -->
                            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="5,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="APACHE WEB SERVER" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF"/>
                                    <TextBlock x:Name="TxtDashApacheStatus" Text="Stopped" FontSize="18" FontWeight="Bold" Foreground="#EF4444" Margin="0,6,0,2"/>
                                    <TextBlock x:Name="TxtDashApacheInfo" Text="Port 80 (Managed)" FontSize="11" Foreground="#6B7280"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 3: MySQL / MariaDB -->
                            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Margin="5,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="DATABASE STATUS" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF"/>
                                    <TextBlock x:Name="TxtDashMysqlStatus" Text="Stopped" FontSize="18" FontWeight="Bold" Foreground="#EF4444" Margin="0,6,0,2"/>
                                    <TextBlock x:Name="TxtDashMysqlInfo" Text="Port 3306 (XAMPP-owned)" FontSize="11" Foreground="#6B7280"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 4: Security Score -->
                            <Border Grid.Column="3" Style="{StaticResource CardBorderStyle}" Margin="10,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="PROTECTION SCORE" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF"/>
                                    <TextBlock x:Name="TxtDashSecurityScore" Text="95% Shielded" FontSize="18" FontWeight="Bold" Foreground="#38BDF8" Margin="0,6,0,2"/>
                                    <TextBlock x:Name="TxtDashSecurityGrade" Text="Grade A+ (Full Isolation)" FontSize="11" Foreground="#6B7280"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Deployment Workflow Progression Bar -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="End-to-End EduGate Protection Workflow" Style="{StaticResource HeaderTextStyle}"/>
                                <TextBlock Text="Follow the 5-stage deployment pipeline to securely package, isolate and verify EduGate on XAMPP." FontSize="12" Foreground="#9CA3AF" Margin="0,0,0,16"/>

                                <Grid Margin="0,8,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Step 1 -->
                                    <Border Grid.Column="0" Background="#111827" BorderBrush="#2563EB" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="STEP 1" FontSize="10" FontWeight="Bold" Foreground="#3B82F6"/>
                                            <TextBlock Text="Import &amp; Stage" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,2"/>
                                            <TextBlock Text="ZIP-Slip &amp; Bomb safe" FontSize="11" Foreground="#6B7280"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Step 2 -->
                                    <Border Grid.Column="1" Background="#111827" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="12" Margin="3,0,3,0">
                                        <StackPanel>
                                            <TextBlock Text="STEP 2" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF"/>
                                            <TextBlock Text="Analyze Code" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,2"/>
                                            <TextBlock Text="PHP syntax &amp; ext check" FontSize="11" Foreground="#6B7280"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Step 3 -->
                                    <Border Grid.Column="2" Background="#111827" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="12" Margin="3,0,3,0">
                                        <StackPanel>
                                            <TextBlock Text="STEP 3" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF"/>
                                            <TextBlock Text="AES-256 Vault" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,2"/>
                                            <TextBlock Text="DPAPI local binding" FontSize="11" Foreground="#6B7280"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Step 4 -->
                                    <Border Grid.Column="3" Background="#111827" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="12" Margin="3,0,3,0">
                                        <StackPanel>
                                            <TextBlock Text="STEP 4" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF"/>
                                            <TextBlock Text="Obfuscate &amp; Build" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,2"/>
                                            <TextBlock Text="Signed SHA manifest" FontSize="11" Foreground="#6B7280"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Step 5 -->
                                    <Border Grid.Column="4" Background="#111827" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="12" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="STEP 5" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF"/>
                                            <TextBlock Text="Deploy &amp; Verify" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,2"/>
                                            <TextBlock Text="403/404 negative tests" FontSize="11" Foreground="#6B7280"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Quick Run: Import, Encrypt &amp; Deploy EduGate Demo" Style="{StaticResource SuccessButton}" Click="BtnQuickDeployDemo_Click" Padding="18,10"/>
                                    <Button Content="Explore Active Configuration" Style="{StaticResource SecondaryButton}" Click="BtnGoToXampp_Click" Margin="12,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Recent System Activity Log & Actions -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="Live Security &amp; Activity Log" Style="{StaticResource HeaderTextStyle}"/>
                                    <TextBox x:Name="TxtDashRecentLogs" Height="180" IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Background="#0F172A" BorderBrush="#1E293B"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="Quick Actions" Style="{StaticResource HeaderTextStyle}"/>
                                    <Button Content="▶️ Start Apache" Style="{StaticResource SecondaryButton}" Click="BtnStartApache_Click" Margin="0,0,0,8" HorizontalAlignment="Stretch"/>
                                    <Button Content="⏹️ Stop Apache" Style="{StaticResource SecondaryButton}" Click="BtnStopApache_Click" Margin="0,0,0,8" HorizontalAlignment="Stretch"/>
                                    <Button Content="🔄 Re-detect XAMPP" Style="{StaticResource SecondaryButton}" Click="BtnRedetect_Click" Margin="0,0,0,8" HorizontalAlignment="Stretch"/>
                                    <Button Content="↩️ Rollback Deployment" Style="{StaticResource DangerButton}" Click="BtnRollback_Click" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB 2: PROJECTS & IMPORT -->
                <ScrollViewer x:Name="ViewProjects" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Import PHP Project Archive (.zip)" Style="{StaticResource HeaderTextStyle}"/>
                                <TextBlock Text="Select a project ZIP archive. SoftBuilt Shield rigorously inspects against Zip Slip (path traversal) and Zip Bombs before staging." FontSize="12" Foreground="#9CA3AF" Margin="0,0,0,16"/>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="TxtZipPath" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Button Grid.Column="1" Content="Browse ZIP..." Style="{StaticResource SecondaryButton}" Click="BtnBrowseZip_Click" Margin="0,0,10,0"/>
                                    <Button Grid.Column="2" Content="Import Project" Click="BtnImportZip_Click"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="✨ Load EduGate Starter Demo ZIP" Style="{StaticResource SuccessButton}" Click="BtnLoadDemo_Click" Margin="0,0,12,0"/>
                                    <TextBlock Text="Creates an authentic school portal application package for instant testing." FontSize="12" Foreground="#6B7280" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Staged Projects List -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Managed Projects in Staging" Style="{StaticResource HeaderTextStyle}"/>
                                <ListBox x:Name="LstProjects" Height="220" Background="#111827" BorderBrush="#374151" Foreground="#F9FAFB" SelectionChanged="LstProjects_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="6" Padding="12" Margin="4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="#38BDF8"/>
                                                        <TextBlock Text="{Binding StagingPath}" FontSize="11" Foreground="#6B7280"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="12" FontWeight="SemiBold" Foreground="#10B981" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB 3: ANALYSIS -->
                <ScrollViewer x:Name="ViewAnalysis" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Codebase Analysis &amp; Requirements Scanner" Style="{StaticResource HeaderTextStyle}"/>
                                        <TextBlock Text="Automatic static scan for PHP version compatibility, required extensions, hardcoded credentials and security risks." FontSize="12" Foreground="#9CA3AF"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Export HTML Report" Style="{StaticResource SecondaryButton}" Click="BtnExportReport_Click"/>
                                </Grid>

                                <!-- Stats Bar -->
                                <Grid Margin="0,16,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#111827" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="TOTAL FILES" FontSize="10" Foreground="#6B7280"/>
                                            <TextBlock x:Name="TxtAnalysisFiles" Text="0" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="#111827" CornerRadius="6" Padding="10" Margin="3,0,3,0">
                                        <StackPanel>
                                            <TextBlock Text="PHP FILES" FontSize="10" Foreground="#6B7280"/>
                                            <TextBlock x:Name="TxtAnalysisPhpFiles" Text="0" FontSize="16" FontWeight="Bold" Foreground="#38BDF8"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="#111827" CornerRadius="6" Padding="10" Margin="3,0,3,0">
                                        <StackPanel>
                                            <TextBlock Text="FRAMEWORK" FontSize="10" Foreground="#6B7280"/>
                                            <TextBlock x:Name="TxtAnalysisFramework" Text="None" FontSize="16" FontWeight="Bold" Foreground="#10B981"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="3" Background="#111827" CornerRadius="6" Padding="10" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="SUPPORTED PHP" FontSize="10" Foreground="#6B7280"/>
                                            <TextBlock x:Name="TxtAnalysisPhpVer" Text="PHP 8.0 - 8.3" FontSize="16" FontWeight="Bold" Foreground="#F59E0B"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Public Directory Confirmation -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Identified Public Directory:" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold"/>
                                    <TextBox x:Name="TxtPublicDir" Grid.Column="1" Text="public" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="(Only files within this folder will be served by Apache DocumentRoot)" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Required Extensions Checklist -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Required PHP Extensions Checklist" Style="{StaticResource HeaderTextStyle}"/>
                                <TextBox x:Name="TxtAnalysisExtensions" Height="90" IsReadOnly="True" FontFamily="Consolas" Background="#111827" BorderBrush="#374151"/>
                            </StackPanel>
                        </Border>

                        <!-- Warnings & Risky Items -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
